// Maatram Volunteer Pass - Prisma schema (Phase 1, trimmed)
// Prisma 6 or older: add   url = env("DATABASE_URL")   inside the datasource block.
// Prisma 7: the connection URL goes in prisma.config.ts instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  VOLUNTEER
  OFFICE_TEAM
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VolunteerType {
  STUDENT
  ALUMNI
  SUPPORTER
}

enum ConsentType {
  DATA_USE
  INTERVIEW_CONTACT
  LINKEDIN_SHARE
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum OpportunityCategory {
  SCHOOL_VISIT
  ADMISSIONS_SUPPORT
  BGV
  MOCK_INTERVIEW
  PANEL_INTERVIEW
  OTHERS
}

enum ApplicationStatus {
  APPLIED
  SELECTED
  REJECTED
  ATTENDED
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum BadgeType {
  EVENT_1
  EVENT_5
  EVENT_10
  HOURS_10
  HOURS_25
  HOURS_50
  LEADERBOARD_TOP1
  LEADERBOARD_TOP2
  LEADERBOARD_TOP3
}

// Users and profiles

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(VOLUNTEER)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  volunteerProfile VolunteerProfile?
  staffProfile     StaffProfile?

  consents             Consent[]
  applications         Application[]
  attendances          Attendance[]  @relation("AttendanceVolunteer")
  recordedAttendances  Attendance[]  @relation("AttendanceRecorder")
  createdOpportunities Opportunity[] @relation("OpportunityCreator")
  badges               UserBadge[]
  auditLogs            AuditLog[]

  @@index([role, status])
}

// Shared by every volunteer (student, alumni, supporter).
model VolunteerProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  type        VolunteerType
  totalHours  Float         @default(0) // cache only; recalculate from Attendance
  totalEvents Int           @default(0) // cache only; recalculate from Attendance
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentDetails StudentDetails?
  alumniDetails  AlumniDetails?

  @@index([type])
}

// Only for students.
model StudentDetails {
  id          String  @id @default(cuid())
  profileId   String  @unique
  collegeName String
  currentYear Int
  passoutYear Int
  degreeCourse   String?
   maatramId   String?       @unique 

  profile VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([passoutYear])
}

// Only for alumni.
model AlumniDetails {
  id             String  @id @default(cuid())
  profileId      String  @unique
  collegeName    String
  graduationYear Int
  maatramId   String?       @unique 
  companyName    String? 
  designation    String?

  profile VolunteerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([graduationYear])
}

// For office team and admin accounts.
model StaffProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  designation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Consent (append-only: insert a new row whenever a choice changes)

model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  granted   Boolean
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

// Opportunities, applications, attendance

model Opportunity {
  id               String              @id @default(cuid())
  title            String
  description      String
  category         OpportunityCategory
  isOnline         Boolean             @default(false)
  location         String?
  meetingLink      String?
  startAt          DateTime
  endAt            DateTime
  deadline         DateTime
  neededVolunteers Int
  eligibility      String?
  status           OpportunityStatus   @default(DRAFT)
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  createdBy    User          @relation("OpportunityCreator", fields: [createdById], references: [id])
  applications Application[]
  attendances  Attendance[]

  @@index([status, startAt])
  @@index([category])
  @@index([createdById])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(APPLIED)
  interested    Boolean           @default(false)
  appliedAt     DateTime          @default(now())
  selectedAt    DateTime?
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId]) // also serves "all applications of one user"
  @@index([opportunityId, status])
  @@index([status])
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  opportunityId String
  checkIn       DateTime?
  checkOut      DateTime?
  hours         Float?
  method        AttendanceMethod @default(QR)
  recordedById  String? // staff member who scanned or entered it
  createdAt     DateTime         @default(now())

  user        User        @relation("AttendanceVolunteer", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId]) 
  @@index([opportunityId])
  @@index([checkIn])
  @@index([userId, checkIn]) 
  @@index([recordedById])
}

// Badges

model Badge {
  id    String    @id @default(cuid())
  type  BadgeType @unique
  label String
  icon  String

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  // "ALL" for event/hour badges, "2026-11" style for monthly leaderboard badges.
  month     String   @default("ALL")
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId, month])
  @@index([badgeId])
  @@index([month])
}

// Activity log

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([entity, entityId])
}